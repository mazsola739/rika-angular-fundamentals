{
  "name": "rika-angular-fundamentals",
  "private": true,
  "version": "2.0.0",
  "description": "My courses app from EPAM's Angular Fundamentals course, written again in 2026 with Angular 22, NgRx and a backend of my own",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "ng serve",
    "dev:server": "ng serve --configuration server",
    "server": "bun --watch server/main.ts",
    "build": "ng build",
    "preview": "ng serve --configuration production",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.server.json",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "pdfjs-dist": "^6.5.438",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
